# PostgreSQL 连接串（本地默认与 docker-compose.yml 对齐）
DATABASE_URL=postgres://plotweaver:plotweaver@127.0.0.1:5432/wenyuan_v3

# AI 供应商：以 OpenAI 兼容协议接入。
# 支持 DeepSeek / Qwen / GLM / Doubao / Kimi 等；Gemini 走独立协议。
# 解析管线按阶段指定模型：便宜档做粗筛与提取，强档做仲裁与二审。
AI_PROVIDER_NAME=deepseek
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=sk-REPLACE_ME
AI_MODEL_EXTRACT=deepseek-chat
AI_MODEL_REVIEW=deepseek-chat

# 思考模式：enabled / disabled（默认 disabled）。
# 推理模型默认开启思考，实测思考 token 占输出的 82%，且会先于正文消耗
# max_tokens —— 吃满时正文为空（空响应故障的主因）。关闭可省约 64% 成本。
# 注意：关闭只能用该配置（内部映射为 thinking={type:disabled}），
# enable_thinking=false 是无效字段，传了不报错也不生效。
AI_THINKING=disabled

# 并发与预算
ANALYSIS_CONCURRENCY=3
ANALYSIS_MONTHLY_BUDGET_USD=50

# 会话签名密钥（HS256）。至少 32 字节；缺失或过短时登录直接报错，不会降级到默认值。
# 生成：openssl rand -base64 48
JWT_SECRET=

# 管理员账号：pnpm db:seed 从这里读取。
# 语义为按邮箱 upsert —— 已存在则重置密码并提升为 ADMIN、重新启用；
# 因此「忘记密码」的恢复方式就是改这里再跑一次 pnpm db:seed。
# 只填 ADMIN_EMAIL 或只填 ADMIN_PASSWORD 会直接报错（半个配置比没有更危险）。
# 两者都不填则只同步关系类型字典、跳过建号。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-8-chars
ADMIN_NAME=管理员
ADMIN_USERNAME=admin

# 外部资料检索源（可选）。配了之后，「导入即解析」会在解析完成后顺带跑三期判定层；
# 不配则只跑 P0–P6，不发起任何检索。
#
# 二选一：
# ① 真实检索源 —— 需要自备，且端点必须接受下面这个契约：
#      POST <SEARCH_API_URL>
#      Authorization: Bearer <SEARCH_API_KEY>
#      {"query": "...", "limit": 5}
#    响应认三种形状：{hits:[...]} / {organic:[...]} / {results:[...]}，
#    每条命中需要 url，可选 title/snippet/content。
#    ⚠️ Tavily / Serper / Bing 的**请求**格式与此不同（Tavily 把 key 放 body、
#    Serper 用 X-API-KEY、Bing 是 GET），不能直接把它们的地址填进来 —— 需要一层转发，
#    或改 `search-provider.ts` 的适配器。
# ② 离线快照 —— 读本地 JSON，零成本、可复现，适合验收：
#      SEARCH_FIXTURE_DIR=knowledge-snapshots
SEARCH_API_URL=
SEARCH_API_KEY=
SEARCH_PROVIDER_NAME=
SEARCH_FIXTURE_DIR=
